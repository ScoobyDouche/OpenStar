{
  "paneLayout" : {
    "background" : {
      "type" : "background",
      "fileHeader" : "/interface/modsmenu/header.png",
      "fileBody" : "/interface/workshopmenu/body.png",
      // All four pieces are vanilla's Mods menu art with a run of identical
      // rows spliced in. The footer gains 16px so two rows of buttons fit on
      // solid panel; the body, list and detail backgrounds gain 84px, which
      // buys a taller mod list and a band for the preview image.
      "fileFooter" : "/interface/workshopmenu/footer.png"
    },

    "windowtitle" : {
      "type" : "title",
      "title" : "Workshop",
      "subtitle" : "^#b9b5b2;Browse the Workshop and your installed mods",
      "position" : [0, 254],
      "icon" : {
        "type" : "image",
        "file" : "/interface/modsmenu/iconmodmanager.png",
        "position" : [0, 0],
        "zlevel" : -1
      }
    },

    "listBackground" : {
      "type" : "image",
      "file" : "/interface/workshopmenu/scrollbg.png",
      "position" : [2, 53],
      "zlevel" : -5
    },

    "informationBackground" : {
      "type" : "image",
      "file" : "/interface/workshopmenu/informationbg.png",
      "position" : [175, 53],
      "zlevel" : -5
    },

    "searchBox" : {
      "type" : "textbox",
      "position" : [8, 307],
      "hint" : "Search Workshop",
      "maxWidth" : 100,
      "fontSize" : 8,
      "border" : true,
      "callback" : "null",
      "enterKey" : "search"
    },

    "searchButton" : {
      "type" : "button",
      "base" : "/interface/button.png",
      "hover" : "/interface/buttonhover.png",
      "pressed" : "/interface/buttonactive.png",
      "caption" : "Search",
      "fontSize" : 7,
      "callback" : "search",
      "position" : [114, 304]
    },

    "itemsArea" : {
      "type" : "scrollArea",
      "rect" : [3, 61, 172, 300],
      "children" : {
        "list" : {
          "type" : "list",
          "callback" : "items",
          "position" : [1, -1],
          "schema" : {
            "selectedBG" : "/interface/modsmenu/modselected.png",
            "unselectedBG" : "/interface/modsmenu/modbackground.png",
            "spacing" : [0, 1],
            "memberSize" : [162, 18],
            "listTemplate" : {
              "background" : {
                "type" : "image",
                "file" : "/interface/modsmenu/modbackground.png",
                "position" : [0, 0],
                "zlevel" : -1
              },
              "name" : {
                "type" : "label",
                "position" : [4, 9],
                "hAnchor" : "left",
                "vAnchor" : "mid",
                "fontSize" : 8,
                "value" : ""
              },
              "state" : {
                "type" : "label",
                "position" : [156, 9],
                "hAnchor" : "right",
                "vAnchor" : "mid",
                "fontSize" : 7,
                "color" : "#b9b5b2",
                "value" : ""
              }
            }
          }
        }
      }
    },

    "status" : {
      "type" : "label",
      "position" : [87, 190],
      "hAnchor" : "mid",
      "vAnchor" : "mid",
      "wrapWidth" : 150,
      "fontSize" : 8,
      "value" : ""
    },

    "statusRetry" : {
      "type" : "button",
      "visible" : false,
      "base" : "/interface/button.png",
      "hover" : "/interface/buttonhover.png",
      "pressed" : "/interface/buttonactive.png",
      "caption" : "Retry",
      "fontSize" : 7,
      "position" : [60, 165]
    },

    // Footer, top row.
    "sortPopular" : {
      "type" : "button",
      "base" : "/interface/button.png",
      "hover" : "/interface/buttonhover.png",
      "baseImageChecked" : "/interface/buttonactive.png",
      "hoverImageChecked" : "/interface/buttonactivehover.png",
      "checkable" : true,
      "checked" : true,
      "caption" : "Popular",
      "fontSize" : 7,
      "position" : [4, 34]
    },

    "sortRecent" : {
      "type" : "button",
      "base" : "/interface/button.png",
      "hover" : "/interface/buttonhover.png",
      "baseImageChecked" : "/interface/buttonactive.png",
      "hoverImageChecked" : "/interface/buttonactivehover.png",
      "checkable" : true,
      "checked" : false,
      "caption" : "Recent",
      "fontSize" : 7,
      "position" : [60, 34]
    },

    "sortSubscribed" : {
      "type" : "button",
      "base" : "/interface/button.png",
      "hover" : "/interface/buttonhover.png",
      "baseImageChecked" : "/interface/buttonactive.png",
      "hoverImageChecked" : "/interface/buttonactivehover.png",
      "checkable" : true,
      "checked" : false,
      "caption" : "Subscribed",
      "fontSize" : 7,
      "position" : [116, 34]
    },

    // Footer, bottom row.
    "prevPage" : {
      "type" : "button",
      "base" : "/interface/button.png",
      "hover" : "/interface/buttonhover.png",
      "pressed" : "/interface/buttonactive.png",
      "caption" : "Prev",
      "fontSize" : 7,
      "position" : [4, 16]
    },

    "pageLabel" : {
      "type" : "label",
      "position" : [87, 23],
      "hAnchor" : "mid",
      "vAnchor" : "mid",
      "fontSize" : 8,
      "value" : ""
    },

    "nextPage" : {
      "type" : "button",
      "base" : "/interface/button.png",
      "hover" : "/interface/buttonhover.png",
      "pressed" : "/interface/buttonactive.png",
      "caption" : "Next",
      "fontSize" : 7,
      "position" : [116, 16]
    },

    // The detail panel's rows line up with the inset slots drawn into
    // informationbg.png: a title band, then four label/value strips, then the
    // description well. Values are right anchored so they land in the boxes.
    "title" : {
      "type" : "label",
      "position" : [262, 312],
      "hAnchor" : "mid",
      "vAnchor" : "mid",
      "fontSize" : 9,
      "value" : ""
    },

    "authorLabel" : {
      "type" : "label",
      "value" : "AUTHOR",
      "position" : [182, 298],
      "hAnchor" : "left",
      "vAnchor" : "mid",
      "color" : "#b9b5b2",
      "fontSize" : 7
    },

    "author" : {
      "type" : "label",
      "value" : "",
      "position" : [341, 298],
      "hAnchor" : "right",
      "vAnchor" : "mid",
      "fontSize" : 8
    },

    "subscribersLabel" : {
      "type" : "label",
      "value" : "SUBSCRIBERS",
      "position" : [182, 284],
      "hAnchor" : "left",
      "vAnchor" : "mid",
      "color" : "#b9b5b2",
      "fontSize" : 7
    },

    "subscribers" : {
      "type" : "label",
      "value" : "",
      "position" : [341, 284],
      "hAnchor" : "right",
      "vAnchor" : "mid",
      "fontSize" : 8
    },

    "stateLabel" : {
      "type" : "label",
      "value" : "STATUS",
      "position" : [182, 270],
      "hAnchor" : "left",
      "vAnchor" : "mid",
      "color" : "#b9b5b2",
      "fontSize" : 7
    },

    "itemState" : {
      "type" : "label",
      "value" : "",
      "position" : [338, 270],
      "hAnchor" : "right",
      "vAnchor" : "mid",
      "fontSize" : 8
    },

    "sourceLabel" : {
      "type" : "label",
      "value" : "SOURCE",
      "position" : [182, 256],
      "hAnchor" : "left",
      "vAnchor" : "mid",
      "color" : "#b9b5b2",
      "fontSize" : 7
    },

    "source" : {
      "type" : "label",
      "value" : "",
      "position" : [341, 256],
      "hAnchor" : "right",
      "vAnchor" : "mid",
      "fontSize" : 8
    },

    "descriptionArea" : {
      "type" : "scrollArea",
      "rect" : [180, 66, 336, 145],
      "children" : {
        "description" : {
          "type" : "label",
          "value" : "",
          "hAnchor" : "left",
          "vAnchor" : "top",
          "fontSize" : 8,
          "wrapWidth" : 150
        }
      }
    },

    "subscribe" : {
      "type" : "button",
      "base" : "/interface/button.png",
      "hover" : "/interface/buttonhover.png",
      "pressed" : "/interface/buttonactive.png",
      "caption" : "Subscribe",
      "fontSize" : 7,
      "position" : [180, 34]
    },

    "retryDownload" : {
      "type" : "button",
      "visible" : false,
      "base" : "/interface/button.png",
      "hover" : "/interface/buttonhover.png",
      "pressed" : "/interface/buttonactive.png",
      "caption" : "Retry",
      "fontSize" : 7,
      "position" : [236, 34]
    },

    "openSteam" : {
      "type" : "button",
      "base" : "/interface/button.png",
